MODEL_URL=http://llama-server:8080

# Max simultaneous LLM requests. Controlled by Orion Light's internal semaphore.
PARALLEL_SLOTS=4

# Absolute path to the SQLite database file.
DB_PATH=/data/db/orion_light.db

# Absolute path where ChromaDB stores its persistent vector index.
CHROMA_PATH=/data/chroma

# Directory containing .gguf model files (shown in the dashboard Models tab).
MODELS_DIR=/data/models

# JWT signing secret — generate with: openssl rand -hex 32
SECRET_KEY=change-me-before-going-to-production

# Maximum character budget for conversation history sent to the LLM.
MAX_CONTEXT_CHARS=12000

# Maximum results returned by web search (DuckDuckGo).
SEARCH_MAX_RESULTS=5

# Password for the auto-seeded admin user (synced automatically on startup if changed).
ADMIN_PASSWORD=change-me-in-production

# External LLM Providers & Routing (Optional)
DEFAULT_PROVIDER=local
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# (docker-compose only) GGUF model filename inside the /models volume.
MODEL_FILE=model.gguf
